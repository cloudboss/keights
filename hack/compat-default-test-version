#!/usr/bin/env python3
# Print the default-test-version from compat.json. Used as the default
# KUBERNETES_VERSION for the Make `image` target when no explicit
# KUBERNETES_VERSION is provided (i.e., the keights-tag sanity build). The
# AMI workflow always passes KUBERNETES_VERSION explicitly, so this helper
# is for local dev and the keights-tag CI path only.

import json
import os
import pathlib
import sys

dir_root = os.environ.get("DIR_ROOT", str(pathlib.Path(__file__).resolve().parent.parent))
compat_file = os.environ.get("COMPAT_FILE", os.path.join(dir_root, "compat.json"))

try:
    with open(compat_file) as f:
        data = json.load(f)
except OSError as e:
    print(f"{compat_file}: {e}", file=sys.stderr)
    sys.exit(1)

print(data["default-test-version"])
