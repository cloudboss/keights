#!/usr/bin/env python3
# Emit the Containerfile build-args pinned for the given Kubernetes patch
# version's minor version in compat.json. The Makefile's `image` target uses
# these so each (keights tag, kubernetes patch) pair builds with the build-arg
# values its minor version expects. The keys in compat.json's image-build-args
# map are the Containerfile ARG names verbatim, so no translation is needed.
#
# Usage: hack/compat-build-args 1.34.5
# Output (single line, suitable for `docker build`):
#   --build-arg AWS_CNI_VERSION=1.20.4 --build-arg ...

import json
import os
import pathlib
import sys

if len(sys.argv) != 2:
    print(f"usage: {sys.argv[0]} KUBERNETES_VERSION", file=sys.stderr)
    sys.exit(1)

kubernetes_version = sys.argv[1]
parts = kubernetes_version.split(".")
if len(parts) < 2:
    print(f"invalid kubernetes version: {kubernetes_version}", file=sys.stderr)
    sys.exit(1)
minor = f"{parts[0]}.{parts[1]}"

dir_root = os.environ.get("DIR_ROOT", str(pathlib.Path(__file__).resolve().parent.parent))
compat_file = os.environ.get("COMPAT_FILE", os.path.join(dir_root, "compat.json"))

try:
    with open(compat_file) as f:
        data = json.load(f)
except OSError as e:
    print(f"{compat_file}: {e}", file=sys.stderr)
    sys.exit(1)

args = data.get("image-build-args", {}).get(minor)
if not args:
    print(f"no image-build-args defined for kubernetes minor version {minor} in {compat_file}",
          file=sys.stderr)
    sys.exit(1)

print(" ".join(f"--build-arg {k}={v}" for k, v in args.items()))
